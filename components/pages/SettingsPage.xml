<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsPage" extends="Group">
  <children>
    <!-- Settings renders persistent playback, app, and account preferences. -->
    <Group id="settingsCanvas" />
  </children>
  <interface>
    <field id="navigateTo" type="string" alwaysNotify="true" />
    <function name="handleKey" />
    <function name="refreshClock" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/shared/AppUi.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/BackendApi.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/PlaylistStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/EntitlementStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/shared/ParentalControlStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/SettingsPage.brs" />
</component>
